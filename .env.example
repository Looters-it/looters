# Read by docker compose. Copy to `.env` and change the password.

# Platform admin, created by the api seed at startup. The password needs at least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=admin@example.test

# Battle resolution queue on Kafka (optional: these are the defaults).
# One partition is one battle resolved in parallel.
# KAFKA_BATTLE_TOPIC=battle.resolve
# KAFKA_BATTLE_PARTITIONS=6

# Log level of api and jobs: debug, info, warn, error.
LOG_LEVEL=info

# Backups (service `backup`, profile `backup`): how often and how many are kept.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
