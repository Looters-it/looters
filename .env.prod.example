# Production settings, read by docker compose. Copy to `.env` on the server and fill in.
# Nothing here has a usable default: the stack refuses to start until these are set.

# Public host name of the game. Its DNS must point to this server before the first
# start: the HTTPS certificate is requested for it.
DOMAIN=gioco.example.org

# Password of the database. It is applied when the data volume is first created.
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Platform admin, created or updated at every start of the api. At least 12 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Optional -------------------------------------------------------------------------

# Log level of api and jobs: debug, info, warn, error.
LOG_LEVEL=info

# Backups: how often, and how many are kept in ./backups.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Memory caps of the containers.
# API_MEMORY=1g
# JOBS_MEMORY=1g
# DB_MEMORY=2g

# Connections of the api to the database.
# DATABASE_POOL_SIZE=30

# Battles resolved in parallel (partitions of the queue). Can only grow.
# KAFKA_BATTLE_PARTITIONS=6
